<view class="page profile-content-page">
  <custom-nav title="{{navTitle}}"></custom-nav>

  <view wx:if="{{status === 'loading'}}" class="state-block">
    <skeleton count="2"></skeleton>
  </view>
  <view wx:elif="{{status === 'error'}}" class="state-block">
    <empty-state title="加载失败" description="{{errorMessage}}" showButton buttonText="重新加载" bind:action="onRetry"></empty-state>
  </view>
  <view wx:else class="card content-card reveal">
    <view class="content-head">
      <text class="content-title">{{heading}}</text>
      <text class="content-time" wx:if="{{updatedAtText}}">更新于 {{updatedAtText}}</text>
    </view>
    <text class="content-text">{{contentText || emptyText}}</text>
  </view>
</view>
