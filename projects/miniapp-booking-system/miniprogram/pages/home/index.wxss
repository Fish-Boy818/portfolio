.page {
  padding: var(--space-page);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.home-page {
  gap: 10rpx;
}

.banner-wrap {
  margin: 0 calc(-1 * var(--space-page));
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: radial-gradient(360rpx 220rpx at 50% 30%, rgba(47, 107, 255, 0.18), transparent 70%),
    linear-gradient(135deg, rgba(90, 200, 255, 0.14), rgba(47, 107, 255, 0.1));
}

.banner {
  overflow: hidden;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-slide {
  position: relative;
  height: 100%;
  overflow: hidden;
}

.banner-image,
.banner-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.banner-image {
  color: #FFFFFF;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.banner-video {
  object-fit: cover;
}

.banner-video-preview {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, rgba(6, 15, 40, 0.5), rgba(14, 35, 95, 0.42));
  backdrop-filter: blur(6rpx);
}

.banner-video-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.6);
  animation: banner-pulse 1.35s ease-in-out infinite;
}

.banner-video-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 1rpx;
}

@keyframes banner-pulse {
  0% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.5);
  }
  70% {
    transform: scale(1.18);
    box-shadow: 0 0 0 12rpx rgba(255, 255, 255, 0);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
  }
}

.banner-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: transparent;
}

.banner-sound-btn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  z-index: 4;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-sound-icon {
  font-size: 30rpx;
  line-height: 1;
}

.banner-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 8rpx;
  z-index: 2;
  color: #FFFFFF;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  font-family: var(--font-title);
  text-shadow: 0 6rpx 16rpx rgba(10, 22, 58, 0.35);
}

.banner-sub {
  font-size: 26rpx;
  opacity: 1;
  text-shadow: 0 6rpx 16rpx rgba(10, 22, 58, 0.35);
}

.category-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.category-chip {
  padding: 12rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(47, 107, 255, 0.16);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chip-icon {
  width: 34rpx;
  height: 34rpx;
}

.chip-text {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.chip-title {
  font-size: 26rpx;
  font-weight: 700;
}

.chip-sub {
  font-size: 26rpx;
  color: var(--color-muted);
}

.section-title {
  margin-top: 0;
}

.club-scroll {
  width: 100%;
}

.club-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 6rpx;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.state-block {
  padding-bottom: 8rpx;
}
