.page {
  padding: var(--space-page);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.club-detail-page {
  padding-top: 0;
}

.custom-nav {
  background: var(--color-bg);
}

.custom-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: calc(100% - 220rpx);
  text-align: center;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-back {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1;
  color: var(--color-text);
}

.club-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.club-hero {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-lg);
  aspect-ratio: 16 / 9;
}

.club-cover-fallback {
  background: linear-gradient(135deg, #cfd8ff, #e9efff);
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: transparent;
  opacity: 0;
}

.hero-text {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
}

.club-info {
  margin-top: -24rpx;
  padding: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.info-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.club-name {
  font-size: 32rpx;
  font-weight: 700;
}

.club-meta {
  font-size: 26rpx;
  color: var(--color-muted);
}

.price-chip {
  background: rgba(47, 107, 255, 0.12);
  color: var(--color-primary);
  padding: 6rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 600;
}

.club-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.tag {
  padding: 4rpx 10rpx;
  border-radius: var(--radius-pill);
  background: rgba(47, 107, 255, 0.12);
  color: var(--color-primary);
  font-size: 26rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  padding: 8rpx 10rpx;
  border-radius: var(--radius-md);
  background: rgba(47, 107, 255, 0.06);
}

.douyin-btn-wrap {
  margin-top: 8rpx;
}

.douyin-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 74rpx;
  gap: 10rpx;
  padding: 0 64rpx 0 18rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, var(--color-primary), #5a9bff);
  color: #fff;
  text-align: center;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(47, 107, 255, 0.22);
  border: 1px solid rgba(255, 255, 255, 0.22);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.douyin-btn:active {
  transform: scale(0.99);
  box-shadow: 0 6rpx 14rpx rgba(47, 107, 255, 0.2);
}

.douyin-btn-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
  flex-shrink: 0;
}

.douyin-btn-text {
  flex: 1;
  text-align: left;
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.douyin-btn-arrow {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
  opacity: 0.96;
}

.club-gallery {
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.gallery-scroll {
  width: 100%;
}

.gallery-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.gallery-item {
  width: 220rpx;
  height: auto;
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-lg);
  overflow: hidden;
  flex: 0 0 auto;
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

.label {
  font-size: 26rpx;
  color: var(--color-muted);
}

.value {
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.section-title {
  margin-top: 0;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.state-block {
  padding-top: 20rpx;
}

