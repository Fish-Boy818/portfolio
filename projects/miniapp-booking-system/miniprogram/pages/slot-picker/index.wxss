.page {
  padding: var(--space-page);
  padding-top: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.date-scroll {
  width: 100%;
}

.date-row {
  display: flex;
  gap: 8rpx;
  padding-bottom: 8rpx;
}

.date-item {
  min-width: 110rpx;
  padding: 10rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(47, 107, 255, 0.12);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  align-items: center;
}

.date-item.active {
  border-color: var(--color-primary);
  background: rgba(47, 107, 255, 0.12);
}

.date-label {
  font-size: 28rpx;
  font-weight: 700;
}

.date-week {
  font-size: 26rpx;
  color: var(--color-muted);
}

.slot-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.slot-item {
  padding: 10rpx 12rpx;
  border-radius: var(--radius-lg);
  background: #FFFFFF;
  border: 2rpx solid rgba(47, 107, 255, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.slot-item.is-active {
  border-color: var(--color-primary);
  background: rgba(47, 107, 255, 0.08);
}

.slot-item.is-disabled {
  opacity: 0.5;
}

.slot-time {
  font-size: 30rpx;
  font-weight: 600;
}

.slot-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.slot-confirm {
  margin-top: 6rpx;
}

.picker-card {
  padding: 16rpx;
  border-radius: var(--radius-lg);
  background: #FFFFFF;
  border: 2rpx solid rgba(47, 107, 255, 0.12);
  font-size: 30rpx;
  font-weight: 600;
}

.state-block {
  padding-top: 20rpx;
}

