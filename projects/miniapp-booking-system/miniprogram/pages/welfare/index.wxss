.page {
  padding: var(--space-page);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hero-card,
.bounty-entry-card,
.form-card,
.list-card {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bounty-entry-card__image {
  width: 100%;
  height: 220rpx;
  border-radius: var(--radius-lg);
  background: #eef3ff;
}

.bounty-entry-card__title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
}

.bounty-entry-card__range {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.bounty-entry-card__status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(47, 107, 255, 0.12);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.bounty-entry-card__tip {
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.hero-title {
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 700;
  font-family: var(--font-title);
}

.hero-desc,
.hero-tip,
.submission-line,
.submission-tip,
.upload-tip {
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.hero-steps {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-step {
  padding: 12rpx 14rpx;
  border-radius: var(--radius-md);
  background: rgba(47, 107, 255, 0.08);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.field-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.field-input,
.field-area {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  border: 2rpx solid rgba(47, 107, 255, 0.18);
  background: #fff;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.field-area {
  min-height: 160rpx;
}

.upload-card {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  border-radius: var(--radius-lg);
  border: 2rpx dashed rgba(47, 107, 255, 0.18);
  background: rgba(47, 107, 255, 0.04);
  padding: 14rpx;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.upload-grid-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: #eef3ff;
}

.upload-grid-image {
  width: 100%;
  height: 100%;
}

.upload-grid-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 12rpx;
}

.upload-grid-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(47, 107, 255, 0.3);
  background: rgba(47, 107, 255, 0.06);
}

.upload-grid-add-icon {
  font-size: 48rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.upload-grid-add-text {
  font-size: 22rpx;
  color: var(--color-muted);
  margin-top: 4rpx;
}

.upload-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.upload-empty {
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.upload-empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.upload-empty-tip {
  font-size: 26rpx;
  color: var(--color-muted);
  text-align: center;
}

.upload-preview {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.upload-image {
  width: 100%;
  max-width: 100%;
  height: 320rpx;
  border-radius: var(--radius-md);
  background: #eef3ff;
}

.upload-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.upload-name,
.submission-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.upload-actions {
  display: flex;
  gap: 10rpx;
}

.mini-btn {
  min-width: 160rpx;
  height: 60rpx;
  border-radius: var(--radius-pill);
  background: rgba(47, 107, 255, 0.14);
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 60rpx;
  padding: 0 12rpx;
}

.mini-btn--ghost {
  background: #fff;
  border: 2rpx solid rgba(47, 107, 255, 0.18);
}

.submission-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-line);
}

.submission-card:first-of-type {
  border-top: none;
  padding-top: 0;
}

.submission-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.submission-no {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.submission-body {
  display: flex;
  gap: 12rpx;
}

.submission-image {
  width: 176rpx;
  height: 176rpx;
  border-radius: var(--radius-md);
  flex: none;
  background: #eef3ff;
}

.submission-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.submission-tip {
  margin-top: 6rpx;
}

.state-block {
  padding-top: 20rpx;
}
