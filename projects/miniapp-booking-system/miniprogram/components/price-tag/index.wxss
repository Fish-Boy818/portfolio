.price-tag {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 8rpx 10rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(140deg, rgba(47, 107, 255, 0.12), rgba(90, 200, 255, 0.14));
  border: 1rpx solid rgba(47, 107, 255, 0.2);
  width: fit-content;
  min-width: 120rpx;
}

.price-tag.is-tall {
  justify-content: space-between;
}

.price-tag.is-unlocked {
  background: linear-gradient(140deg, rgba(29, 78, 216, 0.16), rgba(90, 200, 255, 0.1));
  border-color: rgba(29, 78, 216, 0.25);
}

.price-tag.is-full {
  width: 100%;
  align-items: center;
  text-align: center;
}

.price-tag.is-full .price-main {
  justify-content: center;
}

.price-tag.is-full .price-meta {
  justify-content: center;
}

.price-main {
  display: flex;
  align-items: flex-end;
  gap: 3rpx;
  font-family: var(--font-title);
}

.price-main .currency {
  font-size: 42rpx;
  color: var(--color-primary);
}

.price-main .amount {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
}

.price-meta {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.price-badge {
  padding: 3rpx 8rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 700;
  background: rgba(47, 107, 255, 0.18);
  color: var(--color-primary);
}

.price-tag.is-unlocked .price-badge {
  background: rgba(29, 78, 216, 0.2);
  color: var(--color-secondary);
}

.price-secondary {
  font-size: 26rpx;
  color: var(--color-muted);
  text-decoration: line-through;
}

.price-tip {
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.2;
}

