.order-card {
  padding: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 26rpx;
  color: var(--color-muted);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-body {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.thumb {
  width: 110rpx;
  height: 82rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, rgba(47, 107, 255, 0.22), rgba(90, 200, 255, 0.32));
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.thumb-alt {
  background: linear-gradient(135deg, rgba(29, 78, 216, 0.28), rgba(122, 184, 255, 0.25));
}

.order-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.meta {
  font-size: 26rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.thumb-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.order-price-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.order-price-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(140deg, rgba(47, 107, 255, 0.12), rgba(90, 200, 255, 0.14));
  border: 1rpx solid rgba(47, 107, 255, 0.2);
}

.order-price-main {
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
  font-family: var(--font-title);
  line-height: 1;
}

.order-price-main .currency {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.order-price-main .amount {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.order-price-secondary {
  font-size: 26rpx;
  color: var(--color-muted);
  text-decoration: line-through;
}

.order-price-badge {
  padding: 2rpx 8rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 700;
  background: rgba(47, 107, 255, 0.2);
  color: var(--color-primary);
  line-height: 1.2;
}

.order-actions {
  display: flex;
  gap: 10rpx;
}

.order-actions .btn {
  flex: 1;
  height: 68rpx;
  font-size: 30rpx;
}

