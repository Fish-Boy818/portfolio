.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 44rpx 24rpx;
  text-align: center;
  color: var(--color-muted);
}

.empty-illus {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 14rpx;
}

.empty-illus .ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx dashed rgba(47, 107, 255, 0.3);
  background: rgba(47, 107, 255, 0.06);
}

.empty-illus .dot {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-primary);
  top: 16rpx;
  right: 16rpx;
  box-shadow: 0 8rpx 16rpx rgba(47, 107, 255, 0.25);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.empty-desc {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.empty-btn {
  margin-top: 16rpx;
  min-width: 200rpx;
}
