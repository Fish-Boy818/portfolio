.club-card {
  width: 280rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.club-card--list {
  width: 100%;
  flex-direction: row;
  align-items: stretch;
  min-height: 208rpx;
}

.club-card--list .club-cover {
  width: 250rpx;
  height: 208rpx;
  flex-shrink: 0;
}

.club-card--list .club-body {
  padding: 18rpx;
  flex: 1;
  gap: 10rpx;
}

.club-cover {
  width: 100%;
  height: 210rpx;
  position: relative;
  overflow: hidden;
}

.club-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.club-cover-layer {
  position: absolute;
  inset: 0;
  background: #E7F0FF;
}

.cover-a {
  background: #2F6BFF;
}

.cover-b {
  background: #1D4ED8;
}

.cover-c {
  background: #0EA5E9;
}

.cover-d {
  background: #1E40AF;
}

.cover-e {
  background: #2563EB;
}

.cover-f {
  background: #0284C7;
}

.cover-g {
  background: #3B82F6;
}

.cover-h {
  background: #1D4ED8;
}

.cover-i {
  background: #0F172A;
}

.cover-j {
  background: #60A5FA;
}

.club-body {
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.club-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
}

.club-name {
  font-size: 28rpx;
  font-weight: 700;
}

.club-meta {
  font-size: 26rpx;
  color: var(--color-muted);
}

.club-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}

.tag {
  padding: 4rpx 10rpx;
  border-radius: var(--radius-pill);
  background: rgba(47, 107, 255, 0.12);
  color: var(--color-primary);
  font-size: 26rpx;
}

.club-hours {
  font-size: 26rpx;
  color: var(--color-muted);
}

