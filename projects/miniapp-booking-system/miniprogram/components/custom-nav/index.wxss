.top-nav-placeholder {
  width: 100%;
  flex-shrink: 0;
}

.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  background: rgba(245, 248, 255, 0.96);
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
  box-shadow: 0 2rpx 0 rgba(227, 235, 248, 0.92);
}

.top-nav-inner {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}

.top-side {
  height: 100%;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.top-side-left {
  justify-content: flex-start;
}

.top-side-right {
  justify-content: flex-end;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 26rpx;
  height: 26rpx;
  position: relative;
}

.back-line {
  position: absolute;
  left: 2rpx;
  top: 50%;
  width: 18rpx;
  height: 4rpx;
  border-radius: 99rpx;
  background: var(--color-text);
  transform-origin: 2rpx center;
}

.back-line-top {
  transform: translateY(-50%) rotate(-48deg);
}

.back-line-bottom {
  transform: translateY(-50%) rotate(48deg);
}

.top-title {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
